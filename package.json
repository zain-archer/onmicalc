{
  "name": "omnica",
  "private": true,
  "version": "1.0.0",
  "description": "OmniCalc - free, offline-first scientific, engineering and graphing calculator.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --force",
    "icons": "node scripts/gen-icons.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "desktop:dev": "cargo tauri dev --manifest-path src-tauri/Cargo.toml",
    "desktop:build": "cargo tauri build --manifest-path src-tauri/Cargo.toml",
    "docker:build": "docker build -t omnica:latest .",
    "docker:run": "docker run --rm -p 8080:80 omnica:latest"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
